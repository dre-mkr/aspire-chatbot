[Unit]
Description=ASPIRE background worker (arq)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=aspire
Group=aspire
WorkingDirectory=/srv/aspire/backend

# This unit is what makes the retention promise real.
#
# `app/jobs.py` registers `cron(retention_job, hour=3, minute=15)`, which deletes
# expired anonymous identities and cascades to their conversations -- the
# 180-day commitment published in backend/PRIVACY.md. The job has always been
# correct; nothing ever ran it, because until now there was no unit and no pm2
# app that started an arq worker at all. The audit found 20 identities roughly
# eight months past the window, still holding 20 conversations.
#
# It also runs `summarise_conversation_job`, which only has work to do when
# MEMORY_WINDOW_ENABLED is on. That flag being off does not make this unit
# optional: retention runs either way.
ExecStart=/srv/aspire/backend/.venv/bin/arq app.jobs.WorkerSettings

Environment=PYTHONUNBUFFERED=1

# Unlike the API, a second worker here would be harmless -- arq coordinates
# through Valkey and cron jobs are claimed by one worker. One is plenty for this
# workload, and one keeps the failure modes obvious.
Restart=always
RestartSec=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# Same single writable path as the API: the worker imports app.agent, which
# reaches app.rag, which will create the Chroma directory if it is asked for a
# store. It should not be, but a read-only filesystem failure at 03:15 is not
# how anyone should discover otherwise.
ReadWritePaths=/srv/aspire/backend/data

[Install]
WantedBy=multi-user.target
