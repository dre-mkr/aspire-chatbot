# S2-001 — documented env var VOICE_REALTIME_ENABLED is inert
# Host: local dev, backend/.venv, 2026-08-05
# No database writes performed by this check.

$ grep -n env_prefix backend/app/voice/config.py
(no matches — VoiceSettings has no env_prefix, so field `realtime_enabled`
 binds to REALTIME_ENABLED, not VOICE_REALTIME_ENABLED)

$ grep -n "realtime_enabled" backend/app/voice/config.py
121:    realtime_enabled: bool = False

$ grep -n "VOICE_REALTIME_ENABLED" backend/.env.example backend/app/voice/router.py
backend/.env.example:            VOICE_REALTIME_ENABLED=...
backend/app/voice/router.py:396: detail="Realtime voice is not enabled. Set VOICE_REALTIME_ENABLED=true.",

# Empirical proof:
$ VOICE_REALTIME_ENABLED=true python -c "...get_voice_settings().realtime_enabled"
with VOICE_REALTIME_ENABLED=true -> False        <-- documented var does nothing

$ REALTIME_ENABLED=true python -c "...get_voice_settings().realtime_enabled"
with REALTIME_ENABLED=true      -> True          <-- undocumented var is the real one
