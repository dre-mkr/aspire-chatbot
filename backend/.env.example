# Copy to .env and fill in. .env is gitignored; never commit real keys.

# --- Chat model -------------------------------------------------------------
# Passed to init_chat_model, so "provider:model" selects the provider.
# Name Luna explicitly: the bare "openai:gpt-5.6" alias routes to Sol instead.
CHAT_MODEL=openai:gpt-5.6-luna

# Leave CHAT_TEMPERATURE unset to omit the parameter entirely.
# The GPT-5 family accepts only its default temperature and errors on any other
# value, so do NOT set this while using a gpt-5.6 model.
# CHAT_TEMPERATURE=0.0

# Required for the GPT-5 family: on /v1/chat/completions those models reject
# function tools while reasoning is active, which breaks the retriever tool.
# Routing through /v1/responses keeps tool calling and reasoning working together.
# Applied only when CHAT_MODEL starts with "openai:".
OPENAI_USE_RESPONSES_API=true

# Only the key matching CHAT_MODEL's provider is required.
OPENAI_API_KEY=sk-your-key-here
# ANTHROPIC_API_KEY=

# --- Embeddings -------------------------------------------------------------
# Configured separately from the chat model, and uses the same OPENAI_API_KEY.
# text-embedding-3-large is 3072 dims; text-embedding-3-small (1536) is cheaper.
# Access is granted per OpenAI project, so not every key can use every model --
# an unavailable one fails at ingest with a 403 "does not have access to model".
# To run embeddings locally instead (no key, no per-token cost, ~130 MB download):
#   EMBEDDINGS_PROVIDER=fastembed
#   EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5
# Changing either value changes the vector dimensions and makes an existing store
# unreadable: delete data/chroma and re-run the ingest.
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-large

# --- Knowledge base and vector store ----------------------------------------
# Relative paths resolve against the backend/ directory, not the shell's CWD.
KNOWLEDGE_BASE_CSV=data/knowledge_base.csv
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=aspire_knowledge_base

# Rows longer than CHUNK_SIZE characters are split; shorter rows stay whole.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Snippets fetched per retrieval call.
RETRIEVER_K=4

# --- HTTP -------------------------------------------------------------------
# JSON array. Permissive for local dev; narrow this before deploying.
# The dev origins, NOT a wildcard. A wildcard here means any website can drive
# POST /v2/chat/stream from a visitor's browser at the programme's model cost.
# Production sets its own origin explicitly.
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
LOG_LEVEL=INFO

# --- Learning games ----------------------------------------------------------
# On by default, unlike voice: there is no API key and no external service here,
# so nothing can be missing and nothing can fail at startup. Set false to remove
# the tools and their prompt section together.
GAMES_ENABLED=true

# Whether the assistant may offer a game unasked. Off, deliberately: a game
# starts when a child asks for one, never as a suggestion after a Q&A answer.
GAMES_PROACTIVE_SUGGEST=false

# How long an abandoned game survives. Long enough that a child who wanders off
# and comes back still finds it; short enough that they do not accumulate.
SESSION_TTL_SECONDS=3600

# Typo forgiveness. Repeated-key slips (`savve`) are always forgiven; a general
# one-character edit applies only from this length up, because at four letters
# `safe`, `cave` and `gave` are all one edit from SAVE and all the wrong word.
# Set TYPO_MAX_EDITS=0 for exact matching only.
TYPO_TOLERANCE_MIN_LENGTH=6
TYPO_MAX_EDITS=1

# Hints 1..3 are progressive nudges; asking again reveals the word and moves on.
MAX_HINT_LEVEL=3

# Structured events, one JSON object per line. Nothing is built on these yet —
# they exist so points, badges and streaks are a query later, not a migration.
EVENTS_PATH=data/events/games.jsonl

# --- Voice layer (ElevenLabs) ------------------------------------------------
# Off by default. Turning it on makes a missing voice id a hard startup failure,
# which is what you want before a demo. Everything below is ignored when false.
VOICE_ENABLED=false
ELEVENLABS_API_KEY=

# One voice id per persona covers all three languages, because the multilingual
# models speak all of them. All SIX are REQUIRED when VOICE_ENABLED=true, apart
# from VOICE_EVERYONE, which borrows VOICE_ORION when unset.
#
# VOICE_KALEB was missing from this list, which is why it went uncast: the code
# has read it since the persona split and nothing here ever told an operator to
# set it. `VOICE_EVERYONE` is still honoured as an alias for `VOICE_GUEST`.
# Find ids at https://elevenlabs.io/app/voice-library (Voice ID, not the name).
#
# WHICH VOICE TO PICK. Choosing the id is the only way to set an accent or a
# character -- ElevenLabs has no accent parameter, and the delivery knobs below
# cannot add one. Audition against the persona, not against the label:
#
#   VOICE_STELLA   Skye, ages 5-8.   Female. Warm, bright, encouraging,
#                                    approachable. Playful without performing.
#   VOICE_KALEB    Kaleb, ages 9-12. A key of his own since the split, and he
#                                    deliberately does NOT borrow Skye's -- so
#                                    unset, he has no voice at all and the
#                                    router returns `voice_uncast` rather than
#                                    let a twelve-year-old hear her read his
#                                    lesson. Male, friendly, a little older than
#                                    Skye. Not a small child's voice.
#   VOICE_ORION    Zion, ages 13-18. Young and natural, confident, friendly.
#                                    NOT a children's voice.
#   VOICE_AURORA   Imani, guardians. Mature, calm, warm, reassuring. This is the
#                                    voice answering eligibility and money
#                                    questions, so trust matters most.
#   VOICE_NOVA     Azuri, teachers.  Mature, clear, articulate, unhurried.
#   VOICE_EVERYONE General.          Neutral and friendly; commits to nothing.
#
# On the Caribbean accent: prefer a natural Saint Kitts and Nevis or wider
# Caribbean voice where one reads cleanly, so a local reader hears something
# familiar. Never pick a performed or comic accent, and never trade intelligibility
# for one -- a voice that is hard to follow fails a five-year-old first. If a
# Caribbean voice reads English well but Spanish or French badly, keep it as the
# base and override just that language below.
VOICE_STELLA=
VOICE_KALEB=
VOICE_ORION=
VOICE_AURORA=
VOICE_NOVA=
VOICE_EVERYONE=

# Optional: override one language for one persona.
# VOICE_STELLA_ES=
# VOICE_AURORA_FR=

# --- Delivery, per persona ---------------------------------------------------
# All optional. Unset, the table in app/voice/registry.py stands; these exist so
# that "a shade slower" is an env change rather than a code change and a deploy.
#
#   *_STABILITY         0-1. LOW is expressive and variable, HIGH is even.
#   *_SIMILARITY_BOOST  0-1. How hard to hold the original voice's timbre.
#   *_STYLE             0-1. Exaggeration. Capped at MAX_STYLE in the registry;
#                       the brief asks for warmth, not performance.
#   *_SPEED             0.7-1.2. The one a reader actually notices.
#
# CHANGING ANY OF THESE INVALIDATES THE WARM VOICE CACHE, which is keyed on all
# four (app/voice/cache.py). Expect one slow, billable round of regeneration,
# and re-run tests/scripts/prewarm_voice.py afterwards.
# VOICE_STELLA_SPEED=0.88
# VOICE_STELLA_STYLE=0.40
# VOICE_ORION_SPEED=1.0
# VOICE_AURORA_STABILITY=0.78
# VOICE_NOVA_SPEED=0.96
# VOICE_EVERYONE_SPEED=0.98

# Models. scribe_v1 and eleven_turbo_v2_5 are deprecated; do not put them back.
STT_MODEL=scribe_v2
TTS_MODEL_LIVE=eleven_flash_v2_5
TTS_MODEL_QUALITY=eleven_multilingual_v2

# Domain keyterms improve recognition of ASPIRE, ECCB, Basseterre and similar.
# They add a flat 20% to the cost of every transcription. Set false to compare.
KEYTERMS_ENABLED=true

# Upload gates, both checked before anything reaches a paid API.
MAX_UPLOAD_BYTES=26214400
DURATION_GUARD_BYTES=4194304
MAX_DURATION_SECONDS=60

# Per-session rate limits. Abuse dampening, not authentication -- see the README.
RATE_WINDOW_SECONDS=600
MAX_TRANSCRIPTIONS_PER_WINDOW=20
MAX_SPEECH_PER_WINDOW=40

STT_TIMEOUT_SECONDS=5
TTS_TIMEOUT_SECONDS=8

VOICE_CACHE_DIR=data/voice_cache
VOICE_CACHE_MAX_BYTES=268435456

# Stretch goal, not implemented. Returns 501 either way.
VOICE_REALTIME_ENABLED=false   # now actually bound; was inert before (setting was REALTIME_ENABLED)

# --- Postgres (Neon) --------------------------------------------------------
# MUST be the POOLED connection string -- the host with "-pooler" in it. Neon's
# direct endpoint holds one Postgres backend per connection and will be
# exhausted by a per-request async session pool; the pooled host multiplexes
# through pgbouncer. The app warns at startup if this does not look pooled.
#
# pgvector is installed PER DATABASE, not per project. Migration 0001 runs
# `CREATE EXTENSION IF NOT EXISTS vector` for you, so run `alembic upgrade head`
# against each database you use.
#
# Nothing in the request path reads this yet: at this step the schema and the
# engine exist, and no more. Setting or unsetting it changes no behaviour.
DATABASE_URL=postgresql://user:password@ep-example-123456-pooler.us-east-2.aws.neon.tech/aspire

# Neon scales to zero, so the first request after an idle period pays the
# wake-up. We warm one connection at startup instead of paying for an always-on
# compute. Set false if you disable scale-to-zero on the Neon side instead.
DATABASE_WARM_ON_START=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- Valkey -----------------------------------------------------------------
# Wire-compatible with the Redis 7.2 command set, so redis-py and arq are
# unchanged. Used for the response cache and as the arq queue for background
# summarisation. Leave unset to disable both.
VALKEY_URL=redis://localhost:6380

# Normalized exact-match response caching -- NOT semantic caching, which needs
# the valkey-search module for the FT.* commands. The repeat traffic here is
# near-identical strings that normalisation already collapses.
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_TTL_SECONDS=21600

# --- Conversation memory ----------------------------------------------------
# OFF by default. Enabling it changes what the assistant can recall: the last N
# messages verbatim plus a running summary of everything older, instead of the
# whole thread. Turn it back off and today's behaviour returns exactly, because
# the full transcript is persisted either way.
#
# Requires DATABASE_URL. Run the arq worker too, or summaries never regenerate
# and long conversations silently lose their older context:
#     arq app.jobs.WorkerSettings
MEMORY_WINDOW_ENABLED=false
MEMORY_WINDOW_TURNS=6
MEMORY_SUMMARY_AFTER_TURNS=2

# --- Sessions and accounts --------------------------------------------------
# REQUIRED once accounts are in play. Every session token is signed with this,
# and there is deliberately no default: a signing key with a fallback value is
# a signing key everybody who has read the source also has. Without it, every
# call to /api/auth/* answers 500 — which is loud, and much better than issuing
# tokens anyone can forge.
#
# Generate one:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Changing it invalidates every session in existence, which is the emergency
# lever if a key is ever exposed. Rotating it is a sign-out for everybody, not
# a silent no-op.
SESSION_SECRET=

# How long a session lasts, and how many an address may mint in an hour. The
# cap fails open on purpose: a cache outage must not stop a child opening the
# app. See backend/PRIVACY.md.
# SESSION_TTL_DAYS was removed: it bound to nothing. Token lifetime is
# TOKEN_TTL in app/auth.py, deliberately fixed at 7 days -- see the note
# there on why it is not configurable.
ANONYMOUS_SESSIONS_PER_IP_PER_HOUR=30

# Unclaimed anonymous conversations are swept after this many days by the
# nightly retention job. Claimed and registered accounts are never swept.
ANONYMOUS_RETENTION_DAYS=180

# --- LangGraph platform -----------------------------------------------------
# /v2/chat/stream is the chat, and /admin is the review portal. Both are always
# mounted: `/chat` and `/chat/stream` no longer exist, so there is nothing for a
# flag to choose between. Gate a deployment on `make eval` instead.

# Encrypts `application_pii`. REQUIRED for registration -- the flow refuses to
# persist a national ID or a date of birth without one rather than writing
# plaintext. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=

# Routing and widget planning. Small and old on purpose: routing between six
# names is a short classification job, and a frontier model here would put a
# second expensive call in front of every turn. Falls back to CHAT_MODEL with a
# startup warning if the named provider has no key.
#
# Keep this off the GPT-5 family: those models accept only their own default
# temperature, so CLASSIFIER_TEMPERATURE=0 is silently dropped for them and the
# router stops being deterministic. gpt-4o takes the 0.
#
# Access to OpenAI models is per project. Prefer gpt-4o-mini if your project has
# it. A model your key cannot reach 403s, and the classifier CATCHES that and
# falls back -- so it shows up as bad routing, not as an error.
CLASSIFIER_MODEL=openai:gpt-4o

# Object storage for registration documents. Bytes go browser-to-bucket via a
# presigned URL and never through FastAPI. Unset means uploads answer 503
# rather than falling back to an upload path through this process.
S3_ENDPOINT_URL=
S3_BUCKET=aspire-documents
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# Settings the code reads that this file did not list
#
# Added after an audit found 55 of them. Every value below is the code default,
# so uncommenting one changes nothing until you edit it -- the point is that the
# knob is discoverable at all. Grouped by what they affect.
# ─────────────────────────────────────────────────────────────────────────────

# --- Retrieval tuning (app/agents/qa) ---------------------------------------
# These are the CODE defaults. Several lines here had drifted from them, which
# matters because anyone provisioning from this file got a differently tuned
# system: the floor below was documented as 0.15 against an actual 0.55, and
# QA_RERANK_K as 5 against an actual 4.
# QA_RETRIEVE_K=12
# QA_RERANK_K=4
# QA_RRF_K=60
# QA_RELEVANCE_FLOOR=0.55
# Two floors, not one. Below the hard floor retrieval found nothing and no
# citation rescues the answer; between the two the score is marginal and
# whether the answer cites a retrieved extract decides. See qa/nodes.ground_check.
# QA_RELEVANCE_HARD_FLOOR=0.35
# QA_COVERAGE_FLOOR=0.25
# RETRIEVER_SCORE_THRESHOLD=0.2      # a Chroma-relevance floor; see app/rag.py
# DOC_CHECK_MODEL=

# --- ASPIRE's own contact details --------------------------------------------
# The global prompt tells the model to offer these and never to invent one, and
# for a long time supplied neither -- so a decline named a domain and stopped.
# The defaults in app/config.py are what the corpus already publishes (ASP-208,
# ASP-209, ASP-211, ASP-299/300) and what app/eligibility/content.py already
# hardcodes. Override here if any of them changes.
#
# These five are also exempt from outbound PII redaction (app/safety/pii.py):
# the phone pattern matches the programme's own number, so without the
# exemption a decline would render "[a phone number]". Anything you put here
# inherits that exemption -- do not park a personal number in it.
# ASPIRE_CONTACT_EMAIL=aspire@gov.kn
# ASPIRE_CONTACT_PHONE=+1 (869) 667-5566
# ASPIRE_CONTACT_PHONE_ALT=+1 (869) 762-1947
# ASPIRE_CONTACT_WEBSITE=aspire.gov.kn
# ASPIRE_CONTACT_OFFICE=The Cable Office, Cayon Street, Basseterre (Mon-Fri, 9:00 AM - 3:00 PM)

# --- Rate limiting -----------------------------------------------------------
# Undocumented until now, which meant an operator could not discover the limits
# without reading app/config.py.
# CHAT_MESSAGES_PER_WINDOW=30
# CHAT_RATE_WINDOW_SECONDS=600
# TITLE_REQUESTS_PER_WINDOW=20
# How many graph sessions one address may mint per window. /v2/session had no
# limit at all, and it is where the tokens for every metered endpoint come from.
# Generous on purpose: a real reader mints one per conversation per page load.
# GRAPH_SESSIONS_PER_WINDOW=120

# --- Circuit breaker ---------------------------------------------------------
# BREAKER_FAILURE_THRESHOLD=3
# BREAKER_RESET_SECONDS=60

# --- Caching -----------------------------------------------------------------
# EMBEDDING_CACHE_ENABLED=true
# EMBEDDING_CACHE_TTL_SECONDS=2592000
# SEMANTIC_CACHE_ENABLED=false       # ships disabled on a measurement; see cache.py
# SEMANTIC_CACHE_THRESHOLD=0.95
# SEMANTIC_CACHE_MAX_ENTRIES=512
# Key prefix; set per test run, unset in production. (Own line, not a trailing
# comment -- see the Mail section for what `KEY=   # note` actually parses to.)
# ASPIRE_CACHE_NAMESPACE=

# --- Checkpointer (conversation memory, in Postgres) -------------------------
# CHECKPOINTER_POOL_SIZE=4
# CHECKPOINTER_CONNECT_TIMEOUT=30
# CHECKPOINTER_MAX_LIFETIME=180      # retire pooled connections before Neon hangs up on them

# --- Classifier / model behaviour --------------------------------------------
# CLASSIFIER_TEMPERATURE=0
# CLASSIFIER_STICKINESS_THRESHOLD=0.75
# CHAT_MODEL_BY_PERSONA=
# MAX_TOKENS_BY_PERSONA=
# TOKEN_ENCODING=o200k_base
# FOLLOW_UPS_ALWAYS=true

# --- Widgets -----------------------------------------------------------------
# WIDGETS_ENABLED=true
# WIDGET_BUFFER_LIMIT_BYTES=4096
# WIDGET_CANDIDATE_TTL_DAYS=30

# --- Mail (password reset, sign-in links) ------------------------------------
#
# KEEP THE EXPLANATIONS ON THEIR OWN LINES HERE. `KEY=   # note` is not an empty
# value with a comment: python-dotenv keeps the whole remainder, so the note
# BECOMES the value. That already happened once in production -- RESEND_API_KEY
# held the literal string "# unset => console provider, which LOGS links", which
# is truthy, so app/mail.py skipped the console fallback and POSTed every
# password-reset email to Resend with that as the bearer token. Silent 400s, no
# delivered mail. PUBLIC_WEB_URL had the same shape and every emailed link was
# built from "# base URL used in emailed links".
#
# Unset => console provider. With MAIL_CONSOLE_LOGS_LINKS=false that means reset
# links are logged as an error and NOT delivered -- deliberate, because the link
# is a working credential.
# RESEND_API_KEY=
#
# Must be on a domain verified in the Resend dashboard or every send is refused.
# MAIL_FROM=ASPIRE <no-reply@example.org>
#
# Keep false outside development: true writes working sign-in tokens to the log.
# MAIL_CONSOLE_LOGS_LINKS=false
#
# Base URL used in emailed links. Unset falls back to http://localhost:3000.
# PUBLIC_WEB_URL=https://aspire.eccugenai.app

# --- Object storage (document uploads) ---------------------------------------
# S3_URL_TTL_SECONDS=900

# --- Modules -----------------------------------------------------------------
# ELIGIBILITY_ENABLED=true
# REALTIME_TOKEN_TTL_SECONDS=60
# MAX_SPEAKABLE_CHARS=1500
# RECORD_OUTCOMES=true
# VOLATILE_REVIEW_DAYS=180
# SEED_DIR=

# --- Debugging ---------------------------------------------------------------
# Off by default. The payload is durations and a persona, no message text, but an
# unauthenticated endpoint reporting how the service performs is reconnaissance.
# TIMINGS_ENDPOINT_ENABLED=false
# TIMINGS_RING_CAPACITY=500

# --- Server ------------------------------------------------------------------
# HOST=0.0.0.0
# PORT=8000

# --- Per-persona, per-language ElevenLabs voice ids ---------------------------
# Only needed when VOICE_ENABLED=true. All FIFTEEN combinations (five personas,
# three languages) are validated at startup, so a missing one is a boot failure
# rather than a 500 mid-demo. Setting the base VOICE_<PERSONA> above covers all
# three languages at once; these are for overriding one of them.
# VOICE_STELLA_EN=
# VOICE_STELLA_ES=
# VOICE_STELLA_FR=
# VOICE_ORION_EN=
# VOICE_ORION_ES=
# VOICE_ORION_FR=
# VOICE_AURORA_EN=
# VOICE_AURORA_ES=
# VOICE_AURORA_FR=
# VOICE_NOVA_EN=
# VOICE_NOVA_ES=
# VOICE_NOVA_FR=
# VOICE_EVERYONE_EN=
# VOICE_EVERYONE_ES=
# VOICE_EVERYONE_FR=
