# Design-review tooling is tracked (it is the regression suite); its generated
# output is not. An agent cleaning up "temporary files" deleted the whole
# directory once -- gitignoring the scripts is how that became unrecoverable.
.impeccable/shots/
.impeccable/flash-out/
.impeccable/*.json
.impeccable/*.err
.impeccable/*.txt
.impeccable/*.png

# One package manager. `deploy/update.sh` runs `bun install --frozen-lockfile`
# and CI does the same, so a second lockfile is a second dependency tree that
# can disagree with the one that actually ships.
package-lock.json
pnpm-lock.yaml
yarn.lock
